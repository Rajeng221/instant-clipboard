PORT=5000
NODE_ENV=development

# Redis Connection (Local ya Upstash Cloud URL)
REDIS_URL=redis://127.0.0.1:6379

# Expiration Time in seconds (e.g., 600 seconds = 10 minutes)
CLIPBOARD_TTL_SECONDS=600

# AWS S3 / Cloudflare R2 Storage (Optional for pure text, needed for large images)
AWS_REGION=auto
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_BUCKET_NAME=your_bucket_name
AWS_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com